---
interface Props { size?: string; class?: string; ink?: string; accent?: string }
const { size = '1em', class: cls = '', ink = 'var(--ink)', accent = 'var(--rust)' } = Astro.props;
---
<svg class={`blackhole ${cls}`} width={size} height={size} viewBox="-42 -42 84 84" aria-hidden="true" focusable="false">
  <path d="M -40 0 A 40 8 0 0 1 40 0" fill="none" stroke={accent} stroke-width="2.5" opacity="0.6" />
  <circle cx="0" cy="0" r="20" fill={ink} />
  <circle cx="0" cy="0" r="24" fill="none" stroke={accent} stroke-width="3" />
  <path d="M -40 0 A 40 8 0 0 0 40 0" fill="none" stroke={accent} stroke-width="3.5" />
</svg>
